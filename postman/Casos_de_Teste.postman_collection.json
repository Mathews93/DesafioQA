    {
      "name": "2_LIVROS",
      "item": [
        {
          "name": "1_LISTAR_LIVROS",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "//Salvando o response JSON em uma variável para uso futuro.\r",
                  "var jsonResponse = pm.response.json();\r",
                  "\r",
                  "pm.environment.set(\"isbn1\", jsonResponse.books[0].isbn);\r",
                  "pm.environment.set(\"isbn2\", jsonResponse.books[1].isbn);\r",
                  "\r",
                  "//Validando o status code do response.\r",
                  "pm.test(\"Código é 200\", function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "//Validando se a lista de livros existe no response.\r",
                  "pm.test(\"Lista de livros existe\", function () {\r",
                  "    pm.expect(jsonResponse.books).to.exist;\r",
                  "});\r",
                  "\r",
                  "//Validando se existem pelo menos dois livros na lista.\r",
                  "pm.test(\"Pelo menos dois livros disponíveis\", function () {\r",
                  "    let books = jsonResponse.books;\r",
                  "    pm.expect(books.length).to.be.at.least(2);\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
