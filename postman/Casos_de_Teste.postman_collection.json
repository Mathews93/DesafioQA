      "name": "1_CONTA_DE_USUARIO",
      "item": [
        {
          "name": "1_CRIAR_UM_USUARIO_SUCESSO",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "//Salvando o response JSON em uma variável para uso futuro.",
                  "var jsonResponse = pm.response.json();",
                  "",
                  "//Validando o código de status do response.",
                  "pm.test(\"Código é 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "//Validando se o campo userID não é nulo. Se não for, salva o valor na variável de ambiente userId.",
                  "pm.test(\"ID não é nulo\", () => {",
                  "    pm.expect(jsonResponse.userID).to.not.eq(undefined)",
                  "    pm.environment.set(\"userId\", jsonResponse.userID);",
                  "    pm.environment.set(\"username\", jsonResponse.username);",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "pm.environment.set(\"BASE_URL\", \"https://demoqa.com\");\r",
                  "\r",
                  "//Usei o Mathews + Date.now() para gerar um username único para cada execução do script\r",
                  "pm.environment.set(\"username\", \"Mathews\" + Date.now());\r",
                  "\r",
                  "pm.environment.set(\"password\", \"Senha@123\");"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"userName\": \"{{username}}\",\r\n  \"password\": \"{{password}}\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{BASE_URL}}/Account/v1/User",
              "host": [
                "{{BASE_URL}}"
              ],
              "path": [
                "Account",
                "v1",
                "User"
              ]
            },
            "description": "Generated from cURL: curl -X 'POST' \\\r\n  'https://demoqa.com/Account/v1/User' \\\r\n  -H 'accept: application/json' \\\r\n  -H 'Content-Type: application/json' \\\r\n  -d '{\r\n  \"userName\": \"string\",\r\n  \"password\": \"string\"\r\n}'"
          },
          "response": []
